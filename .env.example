PORT=3000

# Identifiants de l'espace admin (/admin/candidatures)
# Copiez ce fichier en ".env" et changez le mot de passe avant de déployer.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Clé utilisée pour signer les sessions admin — mettez une longue chaîne aléatoire
# (ex: `openssl rand -hex 32`) et gardez-la secrète en production.
SESSION_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Optionnel : dossier où stocker la base de données et les fichiers uploadés
# (utile sur Railway pour pointer vers le volume persistant, ex. /data).
# Laisser vide en local : les fichiers restent dans le dossier du projet.
DATA_DIR=
