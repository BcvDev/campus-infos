<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/jpeg" href="/icon.jpeg">
  <title>Admin — Candidatures | L'Œil du Campus</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">

  <%- include('partials/icones') %>

  <div class="admin-topbar">
    <div class="titre">
      <img src="/logo-mark.png" alt="" class="topbar-logo">
      <div>
        L'Œil du Campus
        <span>Espace admin — candidatures reçues</span>
      </div>
    </div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <a class="btn-export" href="/admin/export.docx"><svg class="ico" aria-hidden="true"><use href="#ic-word"/></svg>Word</a>
      <a class="btn-export" href="/admin/export.pdf"><svg class="ico" aria-hidden="true"><use href="#ic-pdf"/></svg>PDF</a>
      <a class="btn-export" href="/admin/export-fichiers.zip"><svg class="ico" aria-hidden="true"><use href="#ic-archive"/></svg>Documents (.zip)</a>
      <a class="btn-export-discret" href="/admin/export.csv">CSV</a>
      <form method="POST" action="/admin/logout" style="margin:0;">
        <button type="submit" class="btn-export" style="background:transparent; border:1px solid rgba(255,255,255,0.3); cursor:pointer;"><svg class="ico" aria-hidden="true"><use href="#ic-logout"/></svg>Déconnexion</button>
      </form>
    </div>
  </div>

  <div class="admin-wrap">

    <div class="stats-row">
      <div class="stat-card accent">
        <div class="nombre"><%= total %></div>
        <div class="label">Candidatures au total</div>
      </div>
      <div class="stat-card">
        <div class="nombre"><%= recentes %></div>
        <div class="label">Reçues les 7 derniers jours</div>
      </div>
      <div class="stat-card">
        <div class="nombre"><%= Object.keys(parSection).length %></div>
        <div class="label">Sections représentées</div>
      </div>
    </div>

    <% if (Object.keys(parSection).length) { %>
      <div class="sections-badges">
        <% Object.entries(parSection).sort((a,b) => b[1]-a[1]).forEach(([section, n]) => { %>
          <span class="badge-section"><b><%= n %></b> — <%= section %></span>
        <% }) %>
      </div>
    <% } %>

    <div class="admin-toolbar">
      <input type="search" id="recherche" placeholder="Rechercher par nom, section, téléphone ou email…" autocomplete="off">
    </div>

    <div class="table-scroll">
      <table class="admin-table" id="table-candidatures">
        <thead>
          <tr>
            <th>Candidat</th>
            <th>Section</th>
            <th>Filière</th>
            <th>Téléphone</th>
            <th>Email</th>
            <th>N° paiement</th>
            <th>Pièces jointes</th>
            <th>Reçue le</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% candidatures.forEach(c => {
               const initiales = c.nom_complet.trim().split(/\s+/).slice(0,2).map(m => m[0].toUpperCase()).join('');
               const dateAffichee = new Date(c.date_soumission).toLocaleString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
          %>
            <tr data-recherche="<%= (c.nom_complet + ' ' + c.section + ' ' + c.telephone + ' ' + c.email).toLowerCase() %>">
              <td>
                <div class="candidat-nom">
                  <span class="avatar-initiales"><%= initiales %></span>
                  <div>
                    <%= c.nom_complet %><br>
                    <small style="color:var(--text-muted); font-weight:400;">N° carte : <%= c.numero_carte %></small>
                  </div>
                </div>
              </td>
              <td><span class="pill-section"><%= c.section %></span></td>
              <td><%= c.filiere %></td>
              <td><%= c.telephone %></td>
              <td><%= c.email %></td>
              <td><%= c.numero_paiement %></td>
              <td>
                <div class="liens-pieces">
                  <a href="/uploads/<%= c.fichier_carte_etudiant %>" target="_blank">Carte</a>
                  <a href="/uploads/<%= c.fichier_cni %>" target="_blank">CNI</a>
                  <a href="/uploads/<%= c.fichier_lettre_motivation %>" target="_blank">Lettre</a>
                  <a href="/uploads/<%= c.fichier_preuve_paiement %>" target="_blank">Preuve</a>
                  <a href="/admin/candidature/<%= c.id %>/fichiers.zip" style="font-weight:600;"><svg class="ico" aria-hidden="true"><use href="#ic-download"/></svg> Zip</a>
                </div>
              </td>
              <td class="date-cell"><%= dateAffichee %></td>
              <td class="action-cell">
                <form method="POST" action="/admin/candidature/<%= c.id %>/supprimer" onsubmit="return confirmerSuppression(<%= JSON.stringify(c.nom_complet) %>);">
                  <button type="submit" class="btn-supprimer"><svg class="ico" aria-hidden="true"><use href="#ic-trash"/></svg> Supprimer</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (!candidatures.length) { %>
        <div class="aucun-resultat">Aucune candidature reçue pour le moment.</div>
      <% } %>
    </div>
  </div>

  <script>
    function confirmerSuppression(nom) {
      return window.confirm(`Supprimer définitivement la candidature de ${nom} ?\n\nLes fichiers associés seront également supprimés. Cette action est irréversible.`);
    }

    const champRecherche = document.getElementById('recherche');
    const lignes = Array.from(document.querySelectorAll('#table-candidatures tbody tr'));

    champRecherche.addEventListener('input', () => {
      const q = champRecherche.value.trim().toLowerCase();
      lignes.forEach(ligne => {
        const correspond = ligne.dataset.recherche.includes(q);
        ligne.style.display = correspond ? '' : 'none';
      });
    });
  </script>

</body>
</html>
